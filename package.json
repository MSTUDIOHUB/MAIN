{
  "name": "tauri-app",
  "private": true,
  "version": "2.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "icon:app": "node scripts/generate-icons.mjs",
    "build:desktop": "npm run tauri build",
    "build:mac": "npm run tauri build -- --bundles app,dmg",
    "build:mac:unsigned": "npm run tauri build -- --bundles app,dmg --no-sign",
    "build:mac:share": "bash scripts/build-mac-share.sh",
    "build:windows:portable": "powershell -ExecutionPolicy Bypass -File scripts/build-windows-portable.ps1",
    "build:windows": "npm run tauri build -- --target x86_64-pc-windows-msvc --bundles nsis,msi",
    "test:e2e": "playwright test",
    "test:workflow-assets": "node --test tests/node/*.test.mjs",
    "release:bump": "node scripts/release-bump.mjs",
    "release:desktop": "node scripts/release-desktop.mjs",
    "release:local:mac": "node scripts/release-local.mjs mac",
    "release:local:windows": "node scripts/release-local.mjs windows",
    "release:mac:upload": "node scripts/release-local.mjs mac",
    "release:windows:x64": "node scripts/release-local.mjs windows",
    "release:mac": "node scripts/release-mac.mjs",
    "release:stage": "node scripts/prepare-public-release.mjs",
    "aimax:gateway": "node cloud-gateway/aimax/server.mjs",
    "test:aimax-gateway": "node --test tests/node/aimax-gateway.test.mjs"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.62.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "mermaid": "^11.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.2.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tauri-apps/cli": "^2.10.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.7.0",
    "react-refresh": "^0.18.0",
    "ts-morph": "^28.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  },
  "optionalDependencies": {
    "@tauri-apps/cli-darwin-arm64": "^2.10.1"
  }
}
