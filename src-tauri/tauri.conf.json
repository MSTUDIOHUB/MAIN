{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MAIN",
  "mainBinaryName": "MAIN",
  "version": "1.5.7",
  "identifier": "com.localagent.ide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MAIN",
        "width": 1440,
        "height": 900,
        "minWidth": 1120,
        "minHeight": 720,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyQjE1NzE1RTJFNTZDRDUKUldUVmJPWGlGVmV4d2d1QllmaDNxQ2g1ZXA0RUxFM2ZMeVNSK3E2R2tkZkwwUWJEN1o3eVNBUzgK",
      "endpoints": [
        "https://github.com/MSTUDIOHUB/MAIN-Releases/releases/latest/download/latest.json"
      ]
    }
  }
}
